{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|WebFetch|WebSearch|Agent|Task|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/server/dist/hook.js\"",
            "timeout": 25
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/server/dist/hook.js\" --session-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
