{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "newLine": "lf",
    "removeComments": false,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/**/*.ts"]
}
